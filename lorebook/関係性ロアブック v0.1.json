        "2": {
            "uid": 2,
            "key": [
                "約束",
                "約束する",
                "約束した",
                "合意",
                "合意する",
                "決める",
                "決めた",
                "取り決め",
                "一緒に",
                "また会う",
                "待ち合わせ"
            ],
            "keysecondary": [],
            "comment": "合意形成の成立条件",
            "content": "会話中に人物間の合意が形成された可能性がある場合、その会話を確認する。\n\n合意として扱えるのは、双方が内容を認識し、その内容について同意したと判断できる場合である。\n\n一方だけが、\n「そうしようと思う」\n「また会いたい」\n「きっと来てくれる」\n「明日も会えるよね」\nなどと発言しただけでは、両者の合意として扱わない。\n\n曖昧な発言から合意を推測して確定してはならない。\n\n明確に合意が成立した場合、その内容をシナリオ上の事実として保持する。",
            "constant": false,
            "vectorized": false,
            "selective": true,
            "selectiveLogic": 0,
